{
  "storage-driver": "fuse-overlayfs",
  "data-root": "/data/docker/data",
  "exec-root": "/data/docker/run/docker",
  "pidfile": "/data/docker/run/docker.pid",
  "hosts": ["unix:///data/docker/run/docker.sock"],
  "containerd": "/data/docker/run/containerd/containerd.sock",

  "bridge": "none",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "userland-proxy": false,

  "exec-opts": ["native.cgroupdriver=cgroupfs"],
  "no-new-privileges": false,
  "experimental": true,
  "live-restore": false,
  "features": { "buildkit": false },

  "log-driver": "json-file",
  "log-level": "info",
  "log-opts": { "max-size": "10m", "max-file": "3" },

  "registry-mirrors": ["https://gh-proxy.org/docker"],
  "dns": ["223.5.5.5", "8.8.8.8", "1.1.1.1"],
  "default-ulimits": {
    "nofile": { "Name": "nofile", "Soft": 65536, "Hard": 65536 }
  }
}
